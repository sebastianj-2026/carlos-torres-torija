# Puerto del servidor Express
PORT=4000

# Cadena de conexión a Supabase (PostgreSQL)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=aqui_pega_tu_cadena_de_supabase

# Secreto para firmar los JWT
# NUNCA usar este valor — generar con: openssl rand -base64 48
JWT_SECRET=financiera_secret_2024_cambiame

# Duración del token JWT (8 horas)
JWT_EXPIRES_IN=8h

# URL del frontend (para CORS). Lista exacta separada por comas.
FRONTEND_URL=http://localhost:3000

# Sufijo del scope de equipo en Vercel para permitir previews (opt-in).
# Ej: -mi-equipo.vercel.app  → permite financiera-sistema-<hash>-mi-equipo.vercel.app
# Sin esta variable NO se permite ningún preview (evita typosquatting).
# VERCEL_PREVIEW_SUFFIX=-mi-equipo.vercel.app

# Entorno de ejecución
NODE_ENV=development

# Contraseña de usuario sembrado (solo para scripts/generate-passwords.js)
# NO commitear valores reales: este archivo es solo plantilla.
SEED_PWD_SEBASTIAN=cambiame
