# Puerto del servidor Express
PORT=4000

# Cadena de conexión a Supabase (PostgreSQL)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=aqui_pega_tu_cadena_de_supabase

# Secreto para firmar los JWT (usar una cadena larga y aleatoria en producción)
JWT_SECRET=financiera_secret_2024_cambiame

# Duración del token JWT (8 horas)
JWT_EXPIRES_IN=8h

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Entorno de ejecución
NODE_ENV=development

# Contraseña de usuario sembrado (solo para scripts/generate-passwords.js)
# NO commitear valores reales: este archivo es solo plantilla.
SEED_PWD_SEBASTIAN=cambiame
